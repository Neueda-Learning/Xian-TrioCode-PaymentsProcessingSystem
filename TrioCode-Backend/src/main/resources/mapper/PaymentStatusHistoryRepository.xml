<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.hsbc.triocodebackend.repository.PaymentStatusHistoryRepository">

    <resultMap id="HistoryResultMap" type="org.hsbc.triocodebackend.model.PaymentStatusHistory">
        <id     column="id"            property="id"/>
        <result column="payment_id"    property="paymentId"/>
        <result column="from_status"   property="fromStatus"/>
        <result column="to_status"     property="toStatus"/>
        <result column="reference"     property="reference"/>
        <result column="error_code"    property="errorCode"/>
        <result column="error_message" property="errorMessage"/>
        <result column="created_at"    property="createdAt"/>
    </resultMap>

    <select id="selectByPaymentId" resultMap="HistoryResultMap">
        SELECT id, payment_id, from_status, to_status,
               reference, error_code, error_message, created_at
        FROM payment_status_history
        WHERE payment_id = #{paymentId}
        ORDER BY created_at ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO payment_status_history
            (payment_id, from_status, to_status, reference, error_code, error_message, created_at)
        VALUES
            (#{paymentId}, #{fromStatus}, #{toStatus}, #{reference}, #{errorCode}, #{errorMessage}, NOW(3))
    </insert>

</mapper>
